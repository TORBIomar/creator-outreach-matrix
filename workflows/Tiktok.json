      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n  const toEmail = data.email || data.toEmail || \"\";\n\n  const subject = \"can we send you some [Brand] pieces? \ud83e\udd0d\";\n\n  const htmlBody = `\n    <div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #222;\">\n      <p>Hello,</p>\n      \n      <p>Hope you\u2019re having a great week!</p>\n      \n      <p>I'm [Your Name] from [Your Brand]. I came across your page recently and really love your style\u2014your feed feels super natural and genuine, and we\u2019d love to have you wear some of our jewelry.</p>\n      \n      <p>We design waterproof, skin-friendly silver pieces made for daily wear. We want to send you some items to keep and kick off an ongoing partnership.</p>\n      \n      <p><strong>What we offer:</strong></p>\n      <ul style=\"padding-left: 20px; margin: 8px 0;\">\n        <li>3\u20134 jewelry pieces of your choice</li>\n        <li>$25 cash commission on every order placed with your code</li>\n        <li>An exclusive discount code for your community</li>\n        <li>Future gifted drops as we release new collections</li>\n      </ul>\n      \n      <p><strong>A quick heads-up on the arrangement:</strong><br>\n      We cover 100% of the cost of the jewelry pieces, but we do ask you to cover the shipping cost directly for this first package. Once you post and make your first sale through your code you will get your 25$ commission</p>\n      \n      <p>No scripts or strict talking points\u2014we just want you to style the pieces your way and share your honest thoughts.</p>\n      \n      <p>Check out our pieces at <a href=\"https://www.yourbrand.com\" style=\"color: #111; text-decoration: underline;\">yourbrand.com</a>. If this sounds good to you, reply here and I\u2019ll send over your selection link!</p>\n      \n      <p style=\"margin-top: 24px;\">Warm regards,<br>\n      <strong>[Your Name]</strong><br>\n      Team | [Your Brand]</p>\n      \n      <hr style=\"border: none; border-top: 1px solid #e0e0e0; margin: 24px 0 16px 0;\" />\n      \n      <div style=\"font-size: 13px; color: #666; line-height: 1.5;\">\n        <p style=\"margin: 2px 0;\"><strong>[Your Brand]</strong> | You deserve the world\u2019s best</p>\n        <p style=\"margin: 2px 0;\"><a href=\"https://www.yourbrand.com\" style=\"color: #666;\">www.yourbrand.com</a> &nbsp;|&nbsp; <a href=\"mailto:contact@yourbrand.com\" style=\"color: #666;\">contact@yourbrand.com</a></p>\n        <p style=\"margin: 2px 0;\">[Your Business Address]</p>\n        <p style=\"margin: 6px 0 0 0;\">Enter our circle \u2728 IG: <strong>official.yourbrand</strong> | TikTok: <strong>yourbrand_tiktok</strong></p>\n      </div>\n    </div>\n  `;\n\n  return {\n    json: {\n      ...data,\n      subject: subject,\n      html: htmlBody,\n      body: htmlBody,\n      toEmail: toEmail\n    }\n  };\n});"
      },
