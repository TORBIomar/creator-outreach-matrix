        "jsCode": "let parsed = {};\n\n// Extract the response string from LM Studio (OpenAI format)\nlet llmOutput = $json.choices?.[0]?.message?.content || \"{}\";\n\ntry {\n  parsed = typeof llmOutput === 'string' ? JSON.parse(llmOutput) : llmOutput;\n} catch (e) {\n  parsed = { intent: \"unknown\", key_question: null, draft_reply: null };\n}\n\n// Safely access data from 'Split Out' or 'Filter'\nlet sourceItem = {};\ntry {\n  sourceItem = $('Split Out').item.json;\n} catch (err) {\n  try {\n    sourceItem = $('Filter').item.json;\n  } catch (err2) {\n    sourceItem = {};\n  }\n}\n\nreturn {\n  json: {\n    sender: sourceItem.sender || \"Unknown\",\n    fromAddress: sourceItem.fromAddress || null,\n    subject: sourceItem.subject || null,\n    summary: sourceItem.summary || null,\n    intent: parsed.intent || \"unknown\",\n    key_question: parsed.key_question || null,\n    draft_reply: parsed.draft_reply || null\n  }\n};"
