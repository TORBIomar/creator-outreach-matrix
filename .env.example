# ========================================================
# Creator Outreach Matrix - Environment Configuration
# ========================================================

# n8n Webhook Endpoint
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tiktok-leads

# Local File Paths (Optional - defaults to project directory)
# SEEN_FILE=seen_creators.txt
# BACKUP_LEADS_FILE=leads_backup.jsonl
# USER_DATA_DIR=browser_profile

# Telegram Bot (Optional for external notification hooks)
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Zoho Mail API (Configured inside n8n credential manager)
# ZOHO_ACCOUNT_ID=YOUR_ZOHO_ACCOUNT_ID
